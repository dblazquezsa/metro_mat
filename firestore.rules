rules_version = '2';

// Reglas de Firestore para la Caja de herramientas.
// Cópialas en: Consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Un docente es alguien cuyo uid aparece en la colección «docentes».
    // Esos documentos se crean a mano desde la consola (ver la guía).
    function isDocente() {
      return signedIn()
        && exists(/databases/$(database)/documents/docentes/$(request.auth.uid));
    }

    // Progreso de cada estudiante: cada quien lee y escribe el suyo;
    // los docentes pueden leer el de todos (panel del grupo).
    match /progreso/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isDocente());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.size() < 50;
      allow delete: if false;
    }

    // Respuestas de la estación de bienestar: privadas.
    // Solo las lee y escribe su dueño; ni siquiera los docentes.
    match /bienestar/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Nombres de usuario únicos. Se pueden crear una sola vez y nunca cambiar,
    // así que intentar registrar un nombre que ya existe es rechazado.
    match /nombres/{nombre} {
      allow get: if signedIn();
      allow create: if signedIn()
        && nombre.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Lista de docentes: cada persona solo puede comprobar si ella misma es docente.
    match /docentes/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
